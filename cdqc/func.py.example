# cdqc/func.py 예제 — 이 파일을 cdqc/func.py 로 복사한 뒤 사내 로직을 채운다.
#
#   copy cdqc\func.py.example cdqc\func.py
#
# cdqc/func.py 는 .gitignore 에 등록되어 있어 git pull 충돌이 나지 않는다.
# 파일이 없으면 cdqc 는 기본 구현(일반 pandas.read_csv)으로 폴백한다.
#
# 계약 (반드시 지킬 것):
#   - 함수명/시그니처: read_nasca_csv(csv_path) -> pandas.DataFrame
#   - csv_path 는 str 또는 pathlib.Path 둘 다 들어올 수 있다
#   - 반환은 CSV 내용 그대로의 pandas DataFrame (컬럼명 매핑은 config가 함)
#   - cdqc 의 모든 CSV 읽기가 이 함수 하나를 경유한다 (측정 레코드, labels.csv)

from __future__ import annotations

import pandas as pd


def read_nasca_csv(csv_path) -> pd.DataFrame:
    """사내 보안 프로그램이 걸린 CSV → pandas DataFrame."""
    # ── 사내 구현 예시 1: 보안 SDK가 평문 바이트를 돌려주는 경우 ─────────
    # import io
    # from nasca_sdk import decrypt_to_bytes          # (예시 이름)
    # raw = decrypt_to_bytes(str(csv_path))
    # return pd.read_csv(io.BytesIO(raw))
    #
    # ── 사내 구현 예시 2: 보안 해제된 임시 파일 경로를 돌려주는 경우 ─────
    # from nasca_sdk import open_secured
    # with open_secured(str(csv_path)) as plain_path:
    #     return pd.read_csv(plain_path)
    #
    # ── 아래 한 줄은 자리 표시 (보안 프로그램 없는 환경에서만 동작) ──────
    return pd.read_csv(csv_path)
